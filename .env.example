# Environment Variables Example
# Copy this file to .env and update the values as needed

# Node Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Documentation Portal

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feedback Email (server-side)
# Use either SMTP_SERVICE (e.g., "gmail") or SMTP_HOST/SMTP_PORT
SMTP_SERVICE=gmail
SMTP_HOST=gmail
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nathimike102@gmail.com
SMTP_PASS=eymblzjkhxiodpzx
FEEDBACK_TO=nathimike102@gmail.com
FEEDBACK_FROM=nathimike102@gmail.com

# Search Configuration (optional - for Algolia if used)
# NEXT_PUBLIC_ALGOLIA_APP_ID=your_app_id
# NEXT_PUBLIC_ALGOLIA_API_KEY=your_api_key
# NEXT_PUBLIC_ALGOLIA_INDEX_NAME=docs

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
